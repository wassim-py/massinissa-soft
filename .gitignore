# whatsapp bridge runtime & session keys (never commit!)
data/wa-session/
wa-bridge/node_modules/
wa-bridge/package-lock.json
wa-bridge/wa-session/
wa-bridge/wa_bridge_config.json
wa-bridge/*.log
